# Copy to `.env` for local runs. `.env` is git-ignored. NEVER put real secrets in this file.
# The values below are throw-away local development values, not credentials for anything real.

NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=log

# PostgreSQL. With `docker compose up` the "db" service uses these exact credentials (published on host port 5432).
DATABASE_URL=postgresql://padel:padel_dev_only@localhost:5432/padel_hub

# Apply pending SQL migrations when the app starts (handy in development; in production run `npm run db:migrate` explicitly).
MIGRATE_ON_BOOT=true

# Start the pg-boss background job queue inside this process.
JOBS_ENABLED=true

# Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json). Defaults to true outside production.
# SWAGGER_ENABLED=true

# --- Test-only (used by `npm run test:e2e`, not by the app) ---
# TEST_DB=testcontainers     # default: a throw-away Docker container
# TEST_DB=embedded           # no Docker: real PostgreSQL binary from the `embedded-postgres` npm package
# TEST_DATABASE_URL=postgresql://user:pass@host:5432/postgres   # use an existing server (implies TEST_DB=external)
